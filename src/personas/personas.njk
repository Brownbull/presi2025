---
pagination:
  data: personas
  size: 1
  alias: persona
layout: layouts/base.njk
permalink: "/personas/{{ persona.id }}/"
eleventyComputed:
  title: "{{ persona.nombre }} - {{ persona.descripcion }}"
  description: "Perfil y evaluaciones de {{ persona.nombre }}: {{ persona.descripcion }}"
---

<nav class="breadcrumb">
  <a href="/">Inicio</a> / <a href="/personas/">Personas</a> / {{ persona.nombre }}
</nav>

<div class="persona-header">
  <div class="emoji-large">{{ persona.emoji }}</div>
  <div class="header-text">
    <h1>{{ persona.numero }}. {{ persona.nombre }}</h1>
    <p class="descripcion">{{ persona.descripcion }}</p>
    <div class="persona-demographics">
      <span class="age">🎂 {{ persona.edad }}</span>
      <span class="income">💰 {{ persona.ingreso }}</span>
      {% if persona.ocupacion %}
      <span class="ocupacion">💼 {{ persona.ocupacion }}</span>
      {% endif %}
      {% if persona.ubicacion %}
      <span class="ubicacion">📍 {{ persona.ubicacion }}</span>
      {% endif %}
    </div>
  </div>
</div>

{% if persona.fraseTipica %}
<blockquote class="persona-quote-large">
  "{{ persona.fraseTipica }}"
</blockquote>
{% endif %}

<section class="evaluaciones-section">
  <h2>Evaluaciones de Programas</h2>

  {% if persona.evaluacionFile %}
    {% set evalPath = "04_evaluacion_agentes/" + persona.evaluacionFile %}
    {% set evalContent = collections.all | getFileContent(evalPath) %}
    {% if evalContent %}
      <div class="evaluacion-content">
        {{ evalContent | safe }}
      </div>
    {% else %}
      <p class="no-content">Las evaluaciones de esta persona están en proceso.</p>
    {% endif %}
  {% else %}
    <p class="no-content">Las evaluaciones de esta persona están en proceso.</p>
  {% endif %}
</section>

<nav class="persona-nav">
  <a href="/personas/" class="back-link">← Volver a personas</a>
  <a href="/matriz/" class="matriz-link">Ver en la matriz →</a>
</nav>

<style>
.breadcrumb {
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
}

.breadcrumb a {
  color: var(--color-primary);
}

.persona-header {
  display: flex;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  padding-bottom: var(--spacing-lg);
  border-bottom: 2px solid var(--color-border);
  align-items: flex-start;
}

.emoji-large {
  font-size: 5rem;
  line-height: 1;
}

.header-text {
  flex: 1;
}

.header-text h1 {
  margin-bottom: var(--spacing-xs);
}

.header-text .descripcion {
  font-size: 1.2rem;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
}

.persona-quote-large {
  font-size: 1.3rem;
  border-left: 4px solid var(--color-secondary);
  padding-left: var(--spacing-lg);
  padding: var(--spacing-lg);
  margin: var(--spacing-xl) 0;
  font-style: italic;
  color: var(--color-text-secondary);
  background-color: var(--color-bg);
  border-radius: var(--radius-md);
}

.evaluaciones-section {
  margin: var(--spacing-xl) 0;
}

.evaluacion-content {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  line-height: 1.8;
}

.evaluacion-content h1,
.evaluacion-content h2 {
  color: var(--color-primary);
  margin-top: var(--spacing-lg);
}

.evaluacion-content h3 {
  color: var(--color-accent);
}

.evaluacion-content ul {
  margin: var(--spacing-sm) 0;
  padding-left: var(--spacing-xl);
}

.evaluacion-content strong {
  color: var(--color-text);
}

.no-content {
  padding: var(--spacing-xl);
  text-align: center;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.persona-nav {
  margin-top: var(--spacing-xl);
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-border);
  display: flex;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.back-link,
.matriz-link {
  display: inline-block;
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-weight: 500;
  text-decoration: none;
}

.back-link {
  background-color: var(--color-primary);
  color: white;
}

.back-link:hover {
  background-color: #0D47A1;
}

.matriz-link {
  background-color: var(--color-accent);
  color: white;
}

.matriz-link:hover {
  background-color: #00695C;
}

@media (max-width: 768px) {
  .persona-header {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .emoji-large {
    font-size: 4rem;
  }
}
</style>
