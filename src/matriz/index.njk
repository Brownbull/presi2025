.plus-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  background-color: white;
  color: black;
  border: 1px solid black;
  font-weight: 700;
  font-size: 1rem;
  line-height: 1;
  transition: all 0.2s;
}

.persona-details[open] .plus-button {
  transform: rotate(45deg);
  background-color: white;
  color: black;
  border: 1px solid black;
}

.persona-details summary:hover .plus-button {
  background-color: #f0f0f0;
  transform: scale(1.1);
}

.persona-details[open] summary:hover .plus-button {
  background-color: #f0f0f0;
  transform: rotate(45deg) scale(1.1);
}

.persona-expanded {
  margin-top: 0.5rem;
  padding: 0.5rem;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
}

.persona-demographics-expanded {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.7rem;
  color: var(--color-text-secondary);
}

.persona-context-expanded {
  margin-top: 0.75rem;
  font-size: 0.7rem;
}

.context-title {
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 0.25rem;
}

.persona-context-expanded ul {
  margin: 0.25rem 0 0 0;
  padding-left: 1.25rem;
  line-height: 1.5;
}

.persona-context-expanded li {
  margin-bottom: 0.25rem;
  color: var(--color-text-secondary);
}

/* Average row styling */
.average-row {
  background-color: #f0f4f8;
  font-weight: 700;
  border-bottom: 3px solid var(--color-border);
}

.average-label {
  font-weight: 700;
}

.average-header-cell {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.average-name {
  font-weight: 700;
  color: var(--color-text);
  font-size: 0.95rem;
}

.average-cell {
  font-weight: 700;
  font-size: 1.05rem;
}

.promedio-row {
  background-color: var(--color-bg);
  font-weight: 600;
  border-top: 2px solid var(--color-border);
}

.promedio-cell {
  text-align: center;
  font-weight: 600;
  background-color: var(--color-bg);
}

.rankings-section {
  margin-top: var(--spacing-xl);
  padding: var(--spacing-lg);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.ranking-list {
  list-style: none;
  padding: 0;
  margin-top: var(--spacing-md);
}

.ranking-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm);
  border-bottom: 1px solid var(--color-border);
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item .posicion {
  font-weight: 700;
  color: var(--color-text-secondary);
  min-width: 3rem;
  font-size: 1.1rem;
}

.ranking-item .nombre {
  flex: 1;
  font-weight: 500;
  font-size: 1.1rem;
}

.ranking-item .rating {
  font-weight: 700;
  font-size: 1.2rem;
}
</style>
