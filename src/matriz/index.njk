---
layout: layouts/base.njk
title: Matriz de Evaluación
description: Matriz interactiva con 224 evaluaciones de 28 personas sobre 8 candidatos presidenciales
---

<h1>📊 Matriz de Evaluación</h1>

<p class="intro">
  Matriz interactiva con <strong>224 evaluaciones</strong> (28 personas × 8 candidatos).
  Cada celda muestra la calificación que una persona electoral otorga al programa de un candidato,
  en escala de 0-10.
</p>

<div class="matriz-legend">
  <h3>Escala de Colores</h3>
  <div class="legend-items">
    <span class="legend-item"><span class="color-box high"></span> 7.0-10.0: Alto</span>
    <span class="legend-item"><span class="color-box medium"></span> 5.0-6.9: Medio</span>
    <span class="legend-item"><span class="color-box low"></span> 3.0-4.9: Bajo</span>
    <span class="legend-item"><span class="color-box poor"></span> 0-2.9: Muy bajo</span>
  </div>
</div>

<div class="matriz-wrapper">
  <table class="matriz-table" id="matrizTable">
    <thead>
      <tr>
        <th class="sticky-col candidato-header personas-header-special">
          <a href="/personas/" class="persona-column-title">Personas</a>
        </th>
        <th class="candidato-header">
          <select class="candidato-selector" data-column="0">
            <option value="Jeannette Jara" selected>Jeannette Jara</option>
            {% for candidato in matriz.candidatos %}
            {% if candidato != "Jeannette Jara" %}
            <option value="{{ candidato }}">{{ candidato }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </th>
        <th class="candidato-header">
          <select class="candidato-selector" data-column="1">
            <option value="José Antonio Kast" selected>José Antonio Kast</option>
            {% for candidato in matriz.candidatos %}
            {% if candidato != "José Antonio Kast" %}
            <option value="{{ candidato }}">{{ candidato }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </th>
        <th class="candidato-header">
          <select class="candidato-selector" data-column="2">
            <option value="Evelyn Matthei" selected>Evelyn Matthei</option>
            {% for candidato in matriz.candidatos %}
            {% if candidato != "Evelyn Matthei" %}
            <option value="{{ candidato }}">{{ candidato }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </th>
        <th class="candidato-header">
          <select class="candidato-selector" data-column="3">
            <option value="Johannes Kaiser" selected>Johannes Kaiser</option>
            {% for candidato in matriz.candidatos %}
            {% if candidato != "Johannes Kaiser" %}
            <option value="{{ candidato }}">{{ candidato }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </th>
      </tr>
    </thead>
    <tbody>
      {# Average row at the top #}
      <tr class="average-row">
        <td class="persona-cell sticky-col average-label">
            <div class="average-header-cell">
            <div class="average-name">📊 Promedio General</div>
          </div>
        </td>
        <td class="rating-cell average-cell" data-column="0"></td>
        <td class="rating-cell average-cell" data-column="1"></td>
        <td class="rating-cell average-cell" data-column="2"></td>
        <td class="rating-cell average-cell" data-column="3"></td>
      </tr>

      {# Individual persona rows #}
      {% for evaluacion in matriz.evaluaciones %}
      <tr data-evaluacion='{{ evaluacion.evaluaciones | dump | safe }}' data-included="true">
        <td class="persona-cell sticky-col">
          <div class="persona-header-cell">
            <div class="persona-name-row">
              <a href="/personas/{{ evaluacion.numero | personaId }}-{{ evaluacion.nombre | slug }}/" class="persona-link">
                <div class="persona-name">{{ evaluacion.numero }}. {{ evaluacion.nombre }}</div>
              </a>
              <button class="toggle-include-btn" onclick="togglePersonaInclusion(this)" title="Excluir de promedio">
                <span class="exclude-icon">−</span>
                <span class="include-icon" style="display: none;">+</span>
              </button>
            </div>
            {% set persona = personas | find(evaluacion.numero) %}
            {% if persona %}
            <details class="persona-details">
              <summary><span class="plus-button">+</span></summary>
              <div class="persona-expanded">
                <div class="persona-demographics-expanded">
                  {% if persona.edad %}<div>🎂 {{ persona.edad }}</div>{% endif %}
                  {% if persona.ingreso %}<div>💰 {{ persona.ingreso }}</div>{% endif %}
                  {% if persona.ocupacion %}<div>💼 {{ persona.ocupacion }}</div>{% endif %}
                  {% if persona.ubicacion %}<div>📍 {{ persona.ubicacion }}</div>{% endif %}
                  {% if persona.situacion %}<div>👥 {{ persona.situacion }}</div>{% endif %}
                </div>
                {% if persona.contexto and persona.contexto.length > 0 %}
                <div class="persona-context-expanded">
                  <div class="context-title">📋 Contexto</div>
                  <ul>
                    {% for item in persona.contexto %}
                    <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                </div>
                {% endif %}
              </div>
            </details>
            {% endif %}
          </div>
        </td>
        <td class="rating-cell" data-column="0"></td>
        <td class="rating-cell" data-column="1"></td>
        <td class="rating-cell" data-column="2"></td>
        <td class="rating-cell" data-column="3"></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<script>
function calculateColumnAverage(columnIndex, selectedCandidato) {
  const table = document.getElementById('matrizTable');
  const rows = table.querySelectorAll('tbody tr:not(.average-row)');

  let sum = 0;
  let count = 0;

  rows.forEach(row => {
    // Only include rows that are marked as included
    const isIncluded = row.getAttribute('data-included') === 'true';
    if (!isIncluded) return;

    const evaluaciones = JSON.parse(row.getAttribute('data-evaluacion'));
    const rating = evaluaciones[selectedCandidato];

    if (rating !== null && rating !== undefined) {
      sum += rating;
      count++;
    }
  });

  return count > 0 ? sum / count : null;
}

function togglePersonaInclusion(button) {
  const row = button.closest('tr');
  const isIncluded = row.getAttribute('data-included') === 'true';

  // Toggle the included state
  row.setAttribute('data-included', !isIncluded);

  // Toggle button icons
  const excludeIcon = button.querySelector('.exclude-icon');
  const includeIcon = button.querySelector('.include-icon');

  if (isIncluded) {
    // Excluding the row
    row.classList.add('excluded');
    excludeIcon.style.display = 'none';
    includeIcon.style.display = 'inline';
    button.title = 'Incluir en promedio';
  } else {
    // Including the row
    row.classList.remove('excluded');
    excludeIcon.style.display = 'inline';
    includeIcon.style.display = 'none';
    button.title = 'Excluir de promedio';
  }

  // Recalculate all averages
  const selectors = document.querySelectorAll('.candidato-selector');
  selectors.forEach(selector => {
    const columnIndex = parseInt(selector.getAttribute('data-column'));
    updateMatrizColumn(columnIndex, selector.value);
  });
}

function updateMatrizColumn(columnIndex, selectedCandidato) {
  const table = document.getElementById('matrizTable');
  const rows = table.querySelectorAll('tbody tr');

  rows.forEach(row => {
    if (row.classList.contains('average-row')) {
      // Calculate and display average
      const average = calculateColumnAverage(columnIndex, selectedCandidato);
      const cell = row.querySelector(`td.average-cell[data-column="${columnIndex}"]`);

      if (average !== null) {
        let ratingClass = '';
        if (average >= 7) ratingClass = 'high';
        else if (average >= 5) ratingClass = 'medium';
        else if (average >= 3) ratingClass = 'low';
        else ratingClass = 'poor';

        cell.className = `rating-cell average-cell ${ratingClass}`;
        cell.textContent = average.toFixed(2);
      } else {
        cell.className = 'rating-cell average-cell na';
        cell.textContent = 'N/A';
      }
    } else {
      // Regular persona row
      const evaluaciones = JSON.parse(row.getAttribute('data-evaluacion'));
      const cell = row.querySelector(`td[data-column="${columnIndex}"]`);
      const rating = evaluaciones[selectedCandidato];

      if (rating !== null && rating !== undefined) {
        let ratingClass = '';
        if (rating >= 7) ratingClass = 'high';
        else if (rating >= 5) ratingClass = 'medium';
        else if (rating >= 3) ratingClass = 'low';
        else ratingClass = 'poor';

        cell.className = `rating-cell ${ratingClass}`;
        cell.textContent = rating.toFixed(2);
      } else {
        cell.className = 'rating-cell na';
        cell.textContent = 'N/A';
      }
    }
  });
}

// Initialize table with default candidates
document.addEventListener('DOMContentLoaded', function() {
  const selectors = document.querySelectorAll('.candidato-selector');

  selectors.forEach(selector => {
    const columnIndex = parseInt(selector.getAttribute('data-column'));
    updateMatrizColumn(columnIndex, selector.value);

    selector.addEventListener('change', function() {
      updateMatrizColumn(columnIndex, this.value);
    });
  });
});
</script>

<section class="rankings-section">
  <h2>Rankings por Candidato</h2>
  <p>Promedio general de las 28 personas electorales:</p>

  <ol class="ranking-list">
    {% for ranking in matriz.rankings %}
    <li class="ranking-item">
      <span class="posicion">#{{ ranking.posicion }}</span>
      <span class="nombre">{{ ranking.candidato }}</span>
      {% set ratingClass = "" %}
      {% if ranking.promedio >= 7 %}{% set ratingClass = "high" %}
      {% elif ranking.promedio >= 5 %}{% set ratingClass = "medium" %}
      {% elif ranking.promedio >= 3 %}{% set ratingClass = "low" %}
            {% endif %}
      <span class="rating rating-cell {{ ratingClass }}">{{ ranking.promedio | formatNumber }}/10</span>
    </li>
    {% endfor %}
  </ol>
</section>

<style>
.intro {
  font-size: 1.1rem;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-lg);
  max-width: 800px;
}

.matriz-legend {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.matriz-legend h3 {
  margin-top: 0;
  font-size: 1rem;
  margin-bottom: var(--spacing-sm);
}

.legend-items {
  display: flex;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  font-size: 0.9rem;
}

.color-box {
  width: 1.5rem;
  height: 1.5rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
}

.color-box.high { background-color: var(--color-rating-high); }
.color-box.medium { background-color: var(--color-rating-medium); }
.color-box.low { background-color: var(--color-rating-low); }
.color-box.poor { background-color: var(--color-rating-poor); }

.persona-header {
  padding: var(--spacing-xs);
}

.candidato-header {
  padding: var(--spacing-xs);
}

.candidato-selector {
  width: 100%;
  padding: var(--spacing-xs);
  font-size: 0.9rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background-color: var(--color-surface);
  cursor: pointer;
  font-weight: 600;
}

.candidato-selector:hover {
  background-color: var(--color-bg);
}

.candidato-selector:focus {
  outline: 2px solid var(--color-primary);
  outline-offset: 1px;
}

.sticky-col {
  position: sticky;
  left: 0;
  background-color: var(--color-surface);
  z-index: 5;
  text-align: left;
}

.persona-cell {
  text-align: left !important;
}

.persona-column-title {
  color: var(--color-text);
  text-decoration: none;
  font-weight: 600;
}

.persona-column-title:hover {  color: var(--color-primary);  text-decoration: underline;}.personas-header-special {  background-color: #1565C0 !important;}
.personas-header-special .persona-column-title {
  color: white;
  font-weight: 700;
  font-size: 1.1rem;
  text-decoration: none;
}

.personas-header-special .persona-column-title:hover {
  color: #E3F2FD;
  text-decoration: none;
}
  text-decoration: underline;
}

.persona-header-cell {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  text-align: left;
}

.persona-link {
  text-decoration: none;
  color: inherit;
}

.persona-name-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  justify-content: space-between;
}

.persona-name {
  font-weight: 500;
}

.toggle-include-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: white;
  border: none;
  cursor: pointer;
  font-weight: 700;
  font-size: 1.2rem;
  line-height: 1;
  transition: all 0.2s;
  flex-shrink: 0;
}

.toggle-include-btn:hover {
  background-color: var(--color-text);
  transform: scale(1.1);
}

.toggle-include-btn .exclude-icon,
.toggle-include-btn .include-icon {
  display: inline;
}

/* Excluded row styling */
tr.excluded {
  opacity: 0.5;
}

tr.excluded .persona-name,
tr.excluded .rating-cell {
  color: #999 !important;
}

tr.excluded .rating-cell {
  background-color: #f5f5f5 !important;
}

tr.excluded .toggle-include-btn {
  background-color: #999;
}

tr.excluded .toggle-include-btn:hover {
  background-color: var(--color-primary);
}

.persona-details {
  font-size: 0.75rem;
  margin-top: 0.1rem;
}

.persona-details summary {
  cursor: pointer;
  user-select: none;
  padding: 0;
