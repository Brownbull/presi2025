<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}Khujta AI - Análisis Presidencial 2025</title>
  <meta name="description" content="{{ description or 'Análisis generado con Claude Sonnet 4.5 sobre programas presidenciales de Chile 2025. Evaluación de 28 personas electorales sobre 8 candidatos.' }}">
  <meta name="author" content="Khujta AI">
  <link rel="author" href="mailto:khujta.ai@gmail.com">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or 'Análisis con IA sobre Programas Presidenciales Chile 2025' }}">
  <meta property="og:description" content="{{ description or 'Análisis generado con Claude Sonnet 4.5 sobre programas presidenciales de Chile 2025' }}">
  <meta property="og:type" content="website">

  <!-- CSS -->
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
</head>
<body>

  {% include "components/ai-disclaimer.njk" %}

  <header class="site-header">
    <div class="container">
      <h1 class="site-title">
        <a href="{{ '/' | url }}">🤖 Khujta AI<br><span>Análisis Presidencial 2025</span></a>
      </h1>
      <nav class="main-nav">
        <a href="{{ '/' | url }}">Inicio</a>
        <a href="{{ '/programas/' | url }}">Programas</a>
        <a href="{{ '/personas/' | url }}">Personas</a>
        <a href="{{ '/matriz/' | url }}">Evaluación</a>
        <a href="{{ '/metodologia/' | url }}">Metodología</a>
        <a href="https://buymeacoffee.com/khujtaaig" target="_blank" rel="noopener" class="nav-donate">
          ☕ Apóyame con un café
        </a>
      </nav>
    </div>
  </header>

  <main class="site-main">
    <div class="container">
      {{ content | safe }}
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <!-- AI Badge - Always visible as per plan -->
      <div class="ai-badge-footer">
        🤖 Análisis generado con <strong><a href="https://www.anthropic.com/claude" target="_blank" rel="noopener" style="color: inherit; text-decoration: underline;">Claude Sonnet 4.5</a></strong>
      </div>

      <div class="footer-content">
        <div class="footer-section">
          <h3>Sobre este proyecto</h3>
          <p>
            <strong>🤖 Análisis generado con IA</strong><br>
            Este sitio utiliza <strong><a href="https://www.anthropic.com/claude" target="_blank" rel="noopener">Claude Sonnet 4.5</a></strong> de Anthropic para analizar
            programas presidenciales de Chile 2025 desde la perspectiva de 28 personas electorales.
          </p>
          <p class="disclaimer-badge">
            ⚠️ El contenido es informativo y no constituye recomendación electoral
          </p>
        </div>

        <div class="footer-section">
          <h3>Enlaces</h3>
          <ul>
            <li><a href="{{ '/programas/' | url }}">Programas de Candidatos</a></li>
            <li><a href="{{ '/personas/' | url }}">28 Personas Electorales</a></li>
            <li><a href="{{ '/matriz/' | url }}">Matriz de Evaluación</a></li>
            <li><a href="{{ '/metodologia/' | url }}">Metodología del Análisis</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h3>Autor</h3>
          <p>
            Creado por <strong>Khujta AI</strong><br>
            <a href="mailto:khujta.ai@gmail.com" target="_blank" rel="noopener">
              khujta.ai@gmail.com →
            </a>
          </p>
          <p>
            <a href="https://buymeacoffee.com/khujtaaig" target="_blank" rel="noopener" class="donate-button">
              ☕ Apóyame con un café
            </a>
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2025 Khujta AI. Análisis generado con IA.</p>
      </div>
    </div>
  </footer>

  <script src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>
