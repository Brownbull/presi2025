---
pagination:
  data: programas
  size: 1
  alias: programa
layout: layouts/base.njk
permalink: "/programas/{{ programa.slug }}/"
eleventyComputed:
  title: "{{ programa.nombre }}"
  description: "Programa de gobierno de {{ programa.nombre }} - {{ programa.partido }}"
---

<nav class="breadcrumb">
  <a href="{{ '/' | url }}">Inicio</a> / <a href="{{ '/programas/' | url }}">Programas</a> / {{ programa.nombre }}
</nav>

<div class="programa-header">
  <h1>{{ programa.nombre }}</h1>
  <p class="partido">{{ programa.partido }}</p>
  <div class="programa-stats">
    <span class="stat">📄 {{ programa.numMedidas }} medidas específicas</span>
    <span class="stat">📑 {{ programa.secciones }} secciones temáticas</span>
  </div>
  {% if programa.pdfUrl %}
  <div class="programa-pdf">
    <a href="{{ programa.pdfUrl }}" target="_blank" rel="noopener noreferrer" class="pdf-link">
      📥 Descargar programa completo original (PDF)
    </a>
    <p class="pdf-note">Fuente oficial: <a href="https://www.servel.cl/candidaturas-y-programas-elecciones-presidencial-y-parlamentarias-2025/" target="_blank" rel="noopener noreferrer">SERVEL</a></p>
  </div>
  {% endif %}
</div>

<div class="programa-content">
  {{ programa.contenido | markdown | safe }}
</div>

<nav class="programa-nav">
  <a href="{{ '/programas/' | url }}" class="back-link">← Volver a programas</a>
</nav>

<style>
.breadcrumb {
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
}

.breadcrumb a {
  color: var(--color-primary);
}

.programa-header {
  margin-bottom: var(--spacing-xl);
  padding-bottom: var(--spacing-lg);
  border-bottom: 2px solid var(--color-border);
}

.programa-header h1 {
  margin-bottom: var(--spacing-xs);
}

.programa-header .partido {
  font-size: 1.1rem;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
}

.programa-stats {
  display: flex;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.programa-stats .stat {
  background-color: var(--color-bg);
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  font-weight: 500;
}

.programa-pdf {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: #E3F2FD;
  border-left: 4px solid var(--color-primary);
  border-radius: var(--radius-md);
}

.pdf-link {
  display: inline-block;
  padding: var(--spacing-sm) var(--spacing-md);
  background-color: var(--color-primary);
  color: white;
  border-radius: var(--radius-md);
  font-weight: 600;
  text-decoration: none;
  transition: background-color 0.2s;
}

.pdf-link:hover {
  background-color: #0D47A1;
  text-decoration: none;
}

.pdf-note {
  margin-top: var(--spacing-sm);
  font-size: 0.85rem;
  color: var(--color-text-secondary);
}

.pdf-note a {
  color: var(--color-primary);
  font-weight: 500;
}

.programa-content {
  line-height: 1.8;
}

.programa-content h1 {
  font-size: 1.75rem;
  color: var(--color-primary);
  margin-top: var(--spacing-xl);
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}

.programa-content h2 {
  font-size: 1.35rem;
  color: var(--color-accent);
  margin-top: var(--spacing-lg);
}

.programa-content h3 {
  font-size: 1.1rem;
  color: var(--color-text);
}

.programa-content ul {
  margin: var(--spacing-sm) 0 var(--spacing-md);
  padding-left: var(--spacing-xl);
}

.programa-content li {
  margin-bottom: var(--spacing-xs);
}

.programa-content strong {
  color: var(--color-text);
}

.programa-content code {
  background-color: var(--color-bg);
  padding: 0.2rem 0.4rem;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.9em;
}

.programa-nav {
  margin-top: var(--spacing-xl);
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}

.back-link {
  display: inline-block;
  padding: var(--spacing-sm) var(--spacing-md);
  background-color: var(--color-primary);
  color: white;
  border-radius: var(--radius-md);
  font-weight: 500;
  text-decoration: none;
}

.back-link:hover {
  background-color: #0D47A1;
  text-decoration: none;
}
</style>
